   "data": {
    "name": "Generalise Pythagoras",
    "pose": "celebrate",
    "mood": "neutral",
    "narration": "For every right angled triangle, the squares on the two shorter sides have the same total area as the square on the longest side. That is Pythagoras theorem.",
    "prompt": "Would this area relationship hold for a triangle with no right angle?"
   },
   "config": {
    "startMode": "guided",
    "preset": "y8areas",
